import { Request, Response } from 'express';
import MidtransService from '../services/midtransService';
import { supabaseAdmin } from '../config/supabase';
import { NotificationService } from '../services/notificationService';

const midtransService = new MidtransService();

const FAILED_TRANSACTION_STATUSES = new Set(['deny', 'cancel', 'canceled', 'expire']);

const restoreOrderStock = async (orderId: string) => {
  const { data: orderItems, error: orderItemsError } = await supabaseAdmin
    .from('order_items')
    .select('product_id, quantity')
    .eq('order_id', orderId);

  if (orderItemsError) {
    throw new Error(`Failed to fetch order items for restock: ${orderItemsError.message}`);
  }

  for (const item of orderItems || []) {
    if (!item.product_id || !item.quantity) {
      continue;
    }

    const { data: product, error: productError } = await supabaseAdmin
      .from('products')
      .select('id, stock_quantity')
      .eq('id', item.product_id)
      .single();

    if (productError || !product) {
      console.warn('Product not found when restoring stock', {
        order_id: orderId,
        product_id: item.product_id,
        error: productError?.message
      });
      continue;
    }

    const { error: stockUpdateError } = await supabaseAdmin
      .from('products')
      .update({
        stock_quantity: Number(product.stock_quantity || 0) + Number(item.quantity || 0)
      })
      .eq('id', item.product_id);

    if (stockUpdateError) {
      throw new Error(
        `Failed to restore stock for product ${item.product_id}: ${stockUpdateError.message}`
      );
    }
  }
};

const buildPaymentInfo = (paymentType: string | null, midtransResponse: any) => {
  if (!midtransResponse || !paymentType) {
    return {};
  }

  if (paymentType === 'qris') {
    const actions = midtransResponse.actions || [];
    const qrAction = actions.find((action: any) => action.name === 'generate-qr-code');

    return {
      qrString: midtransResponse.qr_string || qrAction?.url,
      expiryTime: midtransResponse.expiry_time
    };
  }

  if (paymentType === 'bank_transfer') {
    const vaNumbers = midtransResponse.va_numbers || [];
    const primaryVa = vaNumbers[0] || {};
    const permataVa = midtransResponse.permata_va_number;

    return {
      vaNumber: primaryVa.va_number || permataVa,
      bank: primaryVa.bank || (permataVa ? 'permata' : undefined),
      expiryTime: midtransResponse.expiry_time
    };
  }

  return {};
};

const buildPaymentResponse = (
  orderNumber: string,
  transaction: any,
  includePaymentInfo = true
) => {
  return {
    transactionId: transaction.transaction_id,
    orderId: orderNumber,
    paymentType: transaction.payment_type,
    transactionStatus: transaction.transaction_status,
    grossAmount: transaction.gross_amount,
    paymentInfo: includePaymentInfo
      ? buildPaymentInfo(transaction.payment_type, transaction.midtrans_response)
      : {}
  };
};

/**
 * Create Payment (QRIS or Bank Transfer)
 * POST /api/payments/charge
 */
export const createPayment = async (req: Request, res: Response) => {
  try {
    const { orderId, paymentMethod, paymentDetails, bank } = req.body;
    const userId = req.userId; // from auth middleware
    
    // Validate input
    if (!orderId || !paymentMethod) {
      return res.status(400).json({ error: 'orderId and paymentMethod are required' });
    }

    // Get order
    const { data: order, error } = await supabaseAdmin
      .from('orders')
      .select('*')
      .eq('order_number', orderId)
      .single();
    
    if (error || !order) {
      return res.status(404).json({ error: 'Order not found' });
    }

    // Check if order belongs to user (security check)
    if (order.user_id !== userId) {
      return res.status(403).json({ error: 'Unauthorized access to order' });
    }

    // Check if order is already paid
    const isAlreadyPaid =
      order.payment_status === 'paid' ||
      ['processing', 'shipped', 'delivered'].includes(order.status);
    if (isAlreadyPaid) {
      return res.status(400).json({ error: 'Order is already paid' });
    }
    
    const validForPayment =
      ['awaiting_payment_method', 'awaiting_payment'].includes(order.status) &&
      order.payment_status === 'unpaid';
    if (!validForPayment) {
      return res.status(400).json({ error: 'Order is not eligible for payment' });
    }

    // Cek apakah order sudah expired
    if (order.expires_at && new Date(order.expires_at) <= new Date()) {
      // Auto-cancel order ini karena sudah melewati batas waktu
      await supabaseAdmin
        .from('orders')
        .update({
          status: 'cancelled',
          payment_status: 'failed',
          updated_at: new Date().toISOString()
        })
        .eq('id', order.id)
        .eq('status', 'awaiting_payment_method'); // Hanya cancel jika masih awaiting_payment_method

      // Restore stock jika berhasil di-cancel
      const { data: updatedOrder } = await supabaseAdmin
        .from('orders')
        .select('status')
        .eq('id', order.id)
        .single();

      if (updatedOrder?.status === 'cancelled') {
        await restoreOrderStock(order.id);
        
        // Kirim notifikasi personal ke pengguna bahwa pesanan dibatalkan karena waktu habis
        await NotificationService.sendPersonalNotification(
          order.user_id,
          'Pesanan Dibatalkan ⏳',
          `Batas waktu pemilihan metode pembayaran untuk pesanan #${order.order_number} telah habis.`,
          'system'
        );
      }

      return res.status(400).json({
        error: 'Order has expired. Please create a new order.',
        code: 'ORDER_EXPIRED'
      });
    }

    // If there is an active pending transaction, return it instead of creating a new one
    const { data: latestTransactions, error: latestTransactionError } = await supabaseAdmin
      .from('transactions')
      .select('*')
      .eq('order_id', order.id)
      .order('created_at', { ascending: false })
      .limit(1);

    if (latestTransactionError) {
      return res.status(500).json({ error: 'Failed to check existing payment' });
    }

    const latestTransaction = latestTransactions?.[0];
    if (latestTransaction?.transaction_status === 'pending') {
      const response = buildPaymentResponse(order.order_number, latestTransaction, true);
      console.info('Active payment returned instead of new charge', {
        order_number: order.order_number,
        transaction_id: latestTransaction.transaction_id
      });
      return res.json({
        success: true,
        message: 'Active payment already exists',
        data: response
      });
    }

    // Customer details (use shipping info from order)
    const customerDetails = {
      first_name: order.shipping_recipient_name || 'Customer',
      email: '', // Optional for QRIS/VA
      phone: order.shipping_phone || ''
    };
    
    let result;
    
    // Call Midtrans based on payment method
    switch (paymentMethod) {
      case 'qris':
        result = await midtransService.chargeQRIS(
          orderId,
          order.total_amount,
          customerDetails
        );
        break;
        
      case 'bank_transfer':
        // Support both formats: { bank: "bca" } or { paymentDetails: { bank: "bca" } }
        const bankCode = bank || paymentDetails?.bank;
        if (!bankCode) {
          return res.status(400).json({ error: 'Bank is required for VA payment' });
        }
        result = await midtransService.chargeBankTransfer(
          orderId,
          order.total_amount,
          bankCode,
          customerDetails
        );
        break;
        
      default:
        return res.status(400).json({ 
          error: 'Invalid payment method. Only qris and bank_transfer are supported.' 
        });
    }
    
    // Save transaction to database
    await supabaseAdmin.from('transactions').insert({
      order_id: order.id,
      transaction_id: result.transaction_id,
      gross_amount: result.gross_amount,
      payment_type: result.payment_type,
      transaction_status: result.transaction_status,
      midtrans_response: result
    });

    // Update order payment method + status
    await supabaseAdmin
      .from('orders')
      .update({
        payment_method: paymentMethod,
        status: 'awaiting_payment'
      })
      .eq('id', order.id);

    // Send "Menunggu Pembayaran" notification if user is logged in
    if (userId) {
      const displayMethod = String(paymentMethod || '').toUpperCase().replace('_', ' ');
      await NotificationService.sendPersonalNotification(
        userId,
        'Menunggu Pembayaran ⏳',
        `Pesanan #${order.order_number} berhasil dibuat. Silakan lakukan pembayaran menggunakan metode ${displayMethod}.`,
        'system'
      );
    }
    
    // Prepare response
    const response = {
      transactionId: result.transaction_id,
      orderId: result.order_id,
      paymentType: result.payment_type,
      transactionStatus: result.transaction_status,
      grossAmount: result.gross_amount,
      paymentInfo: buildPaymentInfo(result.payment_type, result)
    };
    
    res.json({ success: true, data: response });
    
  } catch (error: any) {
    console.error('Payment error:', error);
    res.status(500).json({ 
      error: 'Payment failed', 
      message: error.message 
    });
  }
};

/**
 * Get Active Payment by Order Number
 * GET /api/payments/active/:orderNumber
 */
export const getActivePayment = async (req: Request, res: Response) => {
  try {
    const { orderNumber } = req.params;
    const userId = req.userId; // from auth middleware

    if (!orderNumber) {
      return res.status(400).json({ error: 'Order number is required' });
    }

    const { data: order, error: orderError } = await supabaseAdmin
      .from('orders')
      .select('*')
      .eq('order_number', orderNumber)
      .single();

    if (orderError || !order) {
      return res.status(404).json({ error: 'Order not found' });
    }

    if (order.user_id !== userId) {
      return res.status(403).json({ error: 'Unauthorized access to order' });
    }

    const { data: latestTransactions, error: transactionError } = await supabaseAdmin
      .from('transactions')
      .select('*')
      .eq('order_id', order.id)
      .order('created_at', { ascending: false })
      .limit(1);

    if (transactionError) {
      return res.status(500).json({ error: 'Failed to fetch payment data' });
    }

    const latestTransaction = latestTransactions?.[0];
    if (!latestTransaction) {
      console.warn('Active payment not found for order', {
        order_number: order.order_number
      });
      return res.status(404).json({ error: 'Active payment not found for this order' });
    }

    const isPending = latestTransaction.transaction_status === 'pending';
    const response = buildPaymentResponse(order.order_number, latestTransaction, isPending);

    if (!isPending) {
      console.info('Payment is no longer pending', {
        order_number: order.order_number,
        transaction_id: latestTransaction.transaction_id,
        transaction_status: latestTransaction.transaction_status
      });
    }

    return res.json({ success: true, data: response });
  } catch (error: any) {
    console.error('Get active payment error:', error);
    return res.status(500).json({ error: 'Failed to get active payment' });
  }
};

/**
 * Webhook Handler from Midtrans
 * POST /api/payments/webhook/midtrans
 */
export const handleWebhook = async (req: Request, res: Response) => {
  try {
    const notification = req.body;
    
    // Verify signature
    const isValid = midtransService.verifySignature(notification);
    
    // Log webhook notification
    await supabaseAdmin.from('payment_notifications').insert({
      transaction_id: notification.transaction_id,
      notification_body: notification,
      signature_key: notification.signature_key,
      is_verified: isValid,
      processed_at: isValid ? new Date().toISOString() : null
    });
    
    if (!isValid) {
      console.error('Invalid webhook signature');
      return res.status(403).json({ error: 'Invalid signature' });
    }
    
    const { transaction_status, fraud_status } = notification;
    const normalizedTransactionStatus = String(transaction_status || '').toLowerCase();
    
    // Update transaction
    await supabaseAdmin
      .from('transactions')
      .update({
        transaction_status: normalizedTransactionStatus,
        fraud_status,
        midtrans_response: notification,
        updated_at: new Date().toISOString()
      })
      .eq('transaction_id', notification.transaction_id);
    
    // Determine order status and payment status based on transaction_status
    let orderStatus = 'awaiting_payment';
    let paymentStatus = 'unpaid';
    
    if (['capture', 'settlement'].includes(normalizedTransactionStatus)) {
      if (fraud_status === 'accept' || !fraud_status) {
        // Note: for offline POS orders, status will be overridden to 'completed' below
        orderStatus = 'processing';
        paymentStatus = 'paid';
      }
    } else if (['deny', 'cancel', 'canceled'].includes(normalizedTransactionStatus)) {
      orderStatus = 'cancelled';
      paymentStatus = 'failed';
    } else if (normalizedTransactionStatus === 'expire') {
      orderStatus = 'cancelled';
      paymentStatus = 'failed';
    } else if (normalizedTransactionStatus === 'pending') {
      orderStatus = 'awaiting_payment';
      paymentStatus = 'unpaid';
    }
    
    const { data: transaction } = await supabaseAdmin
      .from('transactions')
      .select('order_id')
      .eq('transaction_id', notification.transaction_id)
      .single();
    
    if (transaction) {
      const { data: existingOrder } = await supabaseAdmin
        .from('orders')
        .select('id, user_id, order_number, status, payment_status, courier, service_type, shipping_address')
        .eq('id', transaction.order_id)
        .single();

      // Send payment status notification if user is logged in
      if (existingOrder && existingOrder.user_id) {
        const isPaymentSuccess =
          ['capture', 'settlement'].includes(normalizedTransactionStatus) &&
          (fraud_status === 'accept' || !fraud_status);

        if (isPaymentSuccess) {
          await NotificationService.sendPersonalNotification(
            existingOrder.user_id,
            'Pembayaran Berhasil 🎉',
            `Pembayaran untuk pesanan #${existingOrder.order_number} telah diterima. Kami sedang memproses pesanan Anda.`,
            'system'
          );
        } else if (['deny', 'cancel', 'canceled'].includes(normalizedTransactionStatus)) {
          await NotificationService.sendPersonalNotification(
            existingOrder.user_id,
            'Pembayaran Dibatalkan ❌',
            `Transaksi pembayaran untuk pesanan #${existingOrder.order_number} dibatalkan atau ditolak.`,
            'system'
          );
        } else if (normalizedTransactionStatus === 'expire') {
          await NotificationService.sendPersonalNotification(
            existingOrder.user_id,
            'Pembayaran Kedaluwarsa ⏳',
            `Batas waktu pembayaran pesanan #${existingOrder.order_number} telah habis.`,
            'system'
          );
        }
      }

      // Offline POS orders (no shipping needed) should go to 'completed' directly
      const isOfflineOrder = existingOrder?.shipping_address === 'POS Offline Transaction';

      const shouldRestoreStock =
        FAILED_TRANSACTION_STATUSES.has(normalizedTransactionStatus) &&
        !!existingOrder &&
        existingOrder.status !== 'cancelled' &&
        existingOrder.payment_status !== 'failed' &&
        existingOrder.payment_status !== 'paid';

      if (shouldRestoreStock) {
        await restoreOrderStock(transaction.order_id);
      }

      // For offline POS orders: payment done = order completed (no shipping needed)
      const finalOrderStatus = isOfflineOrder && orderStatus === 'processing'
        ? 'completed'
        : orderStatus;

      await supabaseAdmin
        .from('orders')
        .update({
          status: finalOrderStatus,
          payment_status: paymentStatus,
          updated_at: new Date().toISOString()
        })
        .eq('id', transaction.order_id);

      // Hanya buat shipment record untuk order ONLINE yang pembayarannya berhasil
      const isPaymentSuccess =
        ['capture', 'settlement'].includes(normalizedTransactionStatus) &&
        (fraud_status === 'accept' || !fraud_status);

      if (isPaymentSuccess && existingOrder && !isOfflineOrder) {
        // Cek apakah sudah ada shipment untuk order ini
        const { data: existingShipment } = await supabaseAdmin
          .from('order_shipments')
          .select('id')
          .eq('order_id', transaction.order_id)
          .single();

        // Hanya buat shipment baru jika belum ada
        if (!existingShipment) {
          const { error: shipmentError } = await supabaseAdmin
            .from('order_shipments')
            .insert({
              order_id: transaction.order_id,
              courier: existingOrder.courier || null,
              service_type: existingOrder.service_type || null,
              tracking_number: null,
              estimated_delivery: null,
              shipped_at: null,
              delivered_at: null,
              notes: null
            });

          if (shipmentError) {
            console.error('Failed to create order shipment:', {
              order_id: transaction.order_id,
              error: shipmentError.message
            });
          } else {
            console.info('Order shipment created for order', {
              order_id: transaction.order_id
            });
          }
        }
      }
    }
    
    res.json({ success: true });
    
  } catch (error: any) {
    console.error('Webhook error:', error);
    res.status(500).json({ error: 'Webhook processing failed' });
  }
};

/**
 * Check Payment Status
 * GET /api/payments/status/:orderId
 */
export const checkStatus = async (req: Request, res: Response) => {
  try {
    const { orderId } = req.params;
    
    if (!orderId) {
      return res.status(400).json({ success: false, message: 'Order ID is required' });
    }
    
    const status = await midtransService.getStatus(orderId as string);
    res.json({ success: true, data: status });
  } catch (error: any) {
    res.status(500).json({ error: 'Status check failed' });
  }
};
</file>

