      });
    }

    if (hst_max < hst_min) {
      return res.status(400).json({
        success: false,
        message: "hst_max harus lebih besar atau sama dengan hst_min",
      });
    }

    if (!detail || !Array.isArray(detail) || detail.length === 0) {
