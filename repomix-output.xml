import crypto from 'crypto';
const midtransClient = require('midtrans-client');

class MidtransService {
  private coreApi: any;

  constructor() {
    this.coreApi = new midtransClient.CoreApi({
      isProduction: process.env.MIDTRANS_IS_PRODUCTION === 'true',
      serverKey: process.env.MIDTRANS_SERVER_KEY,
      clientKey: process.env.MIDTRANS_CLIENT_KEY
    });
  }

  async chargeQRIS(orderId: string, amount: number, customerDetails: any) {
    const parameter = {
      payment_type: 'qris',
      transaction_details: {
        order_id: orderId,
        gross_amount: amount
      },
      customer_details: customerDetails,
      custom_expiry: {
        expiry_duration: 1,
        unit: 'hour'
      }
    };

    return await this.coreApi.charge(parameter);
  }


  async chargeBankTransfer(orderId: string, amount: number, bank: string, customerDetails: any) {
    const parameter = {
      payment_type: 'bank_transfer',
      transaction_details: {
        order_id: orderId,
        gross_amount: amount
      },
      bank_transfer: { bank }, // bca, bni, bri, mandiri, permata
      customer_details: customerDetails,
      custom_expiry: {
        expiry_duration: 1,
        unit: 'hour'
      }
    };

    return await this.coreApi.charge(parameter);
  }

  async getStatus(orderId: string) {
    return await this.coreApi.transaction.status(orderId);
  }

  verifySignature(notification: any): boolean {
    const { order_id, status_code, gross_amount, signature_key } = notification;
    const serverKey = process.env.MIDTRANS_SERVER_KEY;
    const rawString = `${order_id}${status_code}${gross_amount}${serverKey}`;
    const hash = crypto.createHash('sha512').update(rawString).digest('hex');
    return hash === signature_key;
  }
}

export default MidtransService;
</file>

