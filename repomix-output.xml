  published?: boolean;
  featured?: boolean;
  category_id?: string;
  limit?: number;
  offset?: number;
} = {}) => {
  try {
    let query = supabaseAdmin
      .from("blog_articles")
      .select(`
        *,
        category:blog_categories(id, name, slug)
      `)
      .order("created_at", { ascending: false });

