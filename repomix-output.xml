// src/services/offlineTransactionService.ts
import { supabaseAdmin } from '../config/supabase';
import MidtransService from './midtransService';

interface OfflineTransactionItem {
  product_id: string;
  quantity: number;
}

interface CustomerInfo {
  name?: string;
  phone?: string;
  email?: string;
}

interface CreateOfflineTransactionInput {
  items: OfflineTransactionItem[];
  paymentMethod: 'cash' | 'card' | 'qris' | 'bank_transfer';
  bank?: string;
  amountPaid: number;
  customerInfo: CustomerInfo;
  adminId: string;
}

interface OfflineTransactionResult {
  success: boolean;
  order_id: string;
  order_number: string;
  total_amount: number;
  subtotal: number;
  payment_method: string;
  payment_status: string;
  status: string;
  amount_paid: number;
  change: number;
  midtrans?: {
    transaction_id: string;
    payment_type: string;
    status: string;
    qrUrl?: string | null;
    qrString?: string | null;
    bank?: string | null;
    vaNumber?: string | null;
  };
}

const midtransService = new MidtransService();

/**
 * Create an offline transaction (POS checkout)
 * Calls the place_order_offline RPC which handles atomic order creation,
 * stock validation, and deduction.
 */
export async function createOfflineTransaction(
  input: CreateOfflineTransactionInput
): Promise<OfflineTransactionResult> {
  try {
    const {
      items,
      paymentMethod,
      bank,
      amountPaid,
      customerInfo,
      adminId
    } = input;

    // Call the place_order_direct RPC function with p_is_offline set to true
    const { data: rpcResult, error: rpcError } = await supabaseAdmin.rpc(
      'place_order_direct',
      {
        p_user_id: adminId,
        p_address_id: null,
        p_items: items,
        p_payment_method: paymentMethod,
        p_amount_paid: amountPaid,
        p_customer_info: customerInfo,
        p_is_offline: true
      }
    );

    if (rpcError) {
      const msg = rpcError.message ?? '';
      if (msg.includes('Insufficient stock')) {
        throw new Error(msg);
      }
      if (msg.includes('not found')) {
        throw new Error(`Product not found: ${msg}`);
      }
      if (msg.includes('not available')) {
        throw new Error(msg);
      }
      throw new Error(msg || 'Failed to create offline transaction');
    }

    const result = rpcResult as OfflineTransactionResult;

    // If payment method is not cash, generate Midtrans details
    if (paymentMethod !== 'cash' && result.order_number) {
      try {
        let midtransResponse: any;
        if (paymentMethod === 'qris') {
          midtransResponse = await midtransService.chargeQRIS(
            result.order_number,
            result.total_amount,
            {
              email: customerInfo.email || `${result.order_number}@umah-tani.local`,
              phone: customerInfo.phone || '0000000000',
              first_name: customerInfo.name || 'Customer'
            }
          );
        } else if (paymentMethod === 'bank_transfer') {
          const selectedBank = bank || 'bca';
          midtransResponse = await midtransService.chargeBankTransfer(
            result.order_number,
            result.total_amount,
            selectedBank,
            {
              email: customerInfo.email || `${result.order_number}@umah-tani.local`,
              phone: customerInfo.phone || '0000000000',
              first_name: customerInfo.name || 'Customer'
            }
          );
        } else {
          // Fallback / legacy card
          midtransResponse = await generateMidtransToken(
            result.order_number,
            result.total_amount,
            customerInfo
          );
        }

        // Store transaction record for tracking
        await storeMidtransTransaction(result.order_id, midtransResponse);

        // Update order status in database to awaiting_payment
        const { error: updateError } = await supabaseAdmin
          .from('orders')
          .update({
            status: 'awaiting_payment',
            updated_at: new Date().toISOString()
          })
          .eq('id', result.order_id);

        if (updateError) {
          console.warn('Failed to update order status to awaiting_payment:', updateError);
        }

        // Extract credentials to return to frontend
        let paymentData: any = {};
        if (paymentMethod === 'qris') {
          const qrAction = midtransResponse.actions?.find((a: any) => a.name === 'generate-qr-code');
          paymentData = {
            qrUrl: qrAction?.url || null,
            qrString: midtransResponse.qr_string || null
          };
        } else if (paymentMethod === 'bank_transfer') {
          const vaNumber = midtransResponse.va_numbers?.[0];
          paymentData = {
            bank: vaNumber?.bank || bank,
            vaNumber: vaNumber?.va_number || null
          };
        }

        return {
          ...result,
          status: 'awaiting_payment',
          midtrans: {
            transaction_id: midtransResponse.transaction_id,
            payment_type: midtransResponse.payment_type,
            status: midtransResponse.transaction_status,
            ...paymentData
          }
        };
      } catch (midtransError) {
        console.error('Midtrans token generation failed:', midtransError);
        // Don't throw - order was already created, payment attempt can be retried
        return result;
      }
    }

    // For cash payment: order is completed immediately (paid on the spot)
    // RPC sets status='processing' by default, we update it to 'completed'
    if (paymentMethod === 'cash' && result.order_id) {
      const { error: updateError } = await supabaseAdmin
        .from('orders')
        .update({
          status: 'completed',
          updated_at: new Date().toISOString()
        })
        .eq('id', result.order_id);

      if (updateError) {
        console.warn('Failed to update cash order status to completed:', updateError);
      } else {
        result.status = 'completed';
      }
    }

    return result;
  } catch (error: any) {
    console.error('Create offline transaction error:', error);
    throw error;
  }
}

/**
 * Generate Midtrans Core API token for card/bank transfer payment
 */
async function generateMidtransToken(
  orderId: string,
  amount: number,
  customerInfo: CustomerInfo
) {
  try {
    // Try QRIS first
    const qrisResponse = await midtransService.chargeQRIS(orderId, amount, {
      email: customerInfo.email || `${orderId}@umah-tani.local`,
      phone: customerInfo.phone || '0000000000',
      first_name: customerInfo.name || 'Customer'
    });

    return qrisResponse;
  } catch (error) {
    console.error('QRIS token generation failed:', error);
    // Fallback to bank transfer
    try {
      return await midtransService.chargeBankTransfer(
        orderId,
        amount,
        'bca',
        {
          email: customerInfo.email || `${orderId}@umah-tani.local`,
          phone: customerInfo.phone || '0000000000',
          first_name: customerInfo.name || 'Customer'
        }
      );
    } catch (bankError) {
      console.error('Bank transfer token generation failed:', bankError);
      throw bankError;
    }
  }
}

/**
 * Store Midtrans transaction record for offline orders
 */
async function storeMidtransTransaction(
  orderId: string,
  midtransResponse: any
) {
  try {
    const { error } = await supabaseAdmin
      .from('transactions')
      .insert({
        order_id: orderId,
        transaction_id: midtransResponse.transaction_id,
        payment_type: midtransResponse.payment_type,
        transaction_status: midtransResponse.transaction_status,
        midtrans_response: midtransResponse
      });

    if (error) {
      console.warn('Failed to store Midtrans transaction:', error);
      // Don't throw - main transaction already succeeded
    }
  } catch (error) {
    console.error('Error storing Midtrans transaction:', error);
    // Don't throw - main transaction already succeeded
  }
}

/**
 * Fetch receipt data for offline transaction
 */
export async function getOfflineTransactionReceipt(orderId: string) {
  try {
    const { data: order, error: orderError } = await supabaseAdmin
      .from('orders')
      .select(
        `
        id,
        order_number,
        status,
        payment_status,
        payment_method,
        total_amount,
        subtotal,
        shipping_cost,
        shipping_recipient_name,
        shipping_phone,
        created_at,
        order_items(
          id,
          product_id,
          product_name,
          product_price,
          quantity,
          subtotal
        )
      `
      )
      .eq('id', orderId)
      .single();

    if (orderError || !order) {
      throw new Error(`Order not found: ${orderError?.message}`);
    }

    // Sync payment status with Midtrans on-the-fly if not already paid
    if (order && order.payment_status !== 'paid' && order.payment_method !== 'cash') {
      try {
        const midtransStatus = await midtransService.getStatus(order.order_number);
        const transactionStatus = midtransStatus.transaction_status?.toLowerCase();
        const fraudStatus = midtransStatus.fraud_status;

        const isPaymentSuccess =
          ['capture', 'settlement'].includes(transactionStatus) &&
          (fraudStatus === 'accept' || !fraudStatus);

        if (isPaymentSuccess) {
          const { error: updateError } = await supabaseAdmin
            .from('orders')
            .update({
              status: 'completed',
              payment_status: 'paid',
              updated_at: new Date().toISOString()
            })
            .eq('id', orderId);

          if (!updateError) {
            order.status = 'completed';
            order.payment_status = 'paid';
          }
        } else if (['deny', 'cancel', 'expire'].includes(transactionStatus)) {
          const { error: updateError } = await supabaseAdmin
            .from('orders')
            .update({
              status: 'cancelled',
              payment_status: 'failed',
              updated_at: new Date().toISOString()
            })
            .eq('id', orderId);

          if (!updateError) {
            order.status = 'cancelled';
            order.payment_status = 'failed';
          }
        }
      } catch (midtransError: any) {
        console.warn('Failed to sync payment status with Midtrans on receipt fetch:', midtransError.message || midtransError);
      }
    }

    return {
      success: true,
      order
    };
  } catch (error: any) {
    console.error('Get receipt data error:', error);
    throw error;
  }
}

/**
 * Get recent offline transactions for admin dashboard
 */
export async function getRecentOfflineTransactions(limit: number = 10) {
  try {
    const { data: transactions, error } = await supabaseAdmin
      .from('orders')
      .select(
        `
        id,
        order_number,
        status,
        payment_status,
        payment_method,
        total_amount,
        shipping_recipient_name,
        created_at
      `
      )
      .eq('payment_method', 'cash')
      .order('created_at', { ascending: false })
      .limit(limit);

    if (error) {
      throw new Error(`Failed to fetch transactions: ${error.message}`);
    }

    return {
      success: true,
      data: transactions || []
    };
  } catch (error: any) {
    console.error('Get recent transactions error:', error);
    throw error;
  }
}
