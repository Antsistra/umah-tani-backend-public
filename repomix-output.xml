/**
 * Get all orders with filters
 * GET /api/admin/orders
 */
export const getAllOrders = async (req: Request, res: Response) => {
  try {
    const { page = 1, limit = 20, status, search } = req.query;
    const offset = (Number(page) - 1) * Number(limit);

    let query = supabaseAdmin
      .from('orders')
      .select(`
        *,
        transactions(transaction_id, payment_type, transaction_status),
        order_items(quantity)
      `, { count: 'exact' })
      .neq('shipping_address', 'POS Offline Transaction'); // Exclude offline POS orders from online orders list

    // Apply filters
    if (status && status !== 'all') {
      query = query.eq('status', status);
    }

    if (search) {
      query = query.or(`order_number.ilike.%${search}%,shipping_recipient_name.ilike.%${search}%`);
    }

    // Pagination
    query = query
      .order('created_at', { ascending: false })
      .range(offset, offset + Number(limit) - 1);

    const { data, error, count } = await query;

    if (error) throw error;

    // Fetch user profiles manually since direct join with auth.users is invalid
    if (data && data.length > 0) {
      const userIds = [...new Set(data.map(order => order.user_id).filter(Boolean))];
      const { data: profiles } = await supabaseAdmin
        .from('profiles')
        .select('id, email, name')
        .in('id', userIds);

      const profileMap = new Map(profiles?.map(p => [p.id, p]) || []);

      data.forEach(order => {
        const profile = profileMap.get(order.user_id);
        if (profile) {
          order.user = {
            ...profile,
            name: profile.name || order.shipping_recipient_name || null
          };
        } else {
          order.user = {
            id: order.user_id,
            email: "Unknown",
            name: order.shipping_recipient_name || null
          };
        }
      });
    }

    res.json({
      success: true,
      data,
      pagination: {
        page: Number(page),
        limit: Number(limit),
        total: count || 0,
        totalPages: Math.ceil((count || 0) / Number(limit))
      }
    });
  } catch (error: any) {
    console.error('Get orders error:', error);
    res.status(500).json({ error: 'Failed to fetch orders' });
  }
};

/**
 * Get order detail
 * GET /api/admin/orders/:id
 */
export const getOrderDetail = async (req: Request, res: Response) => {
  try {
    const { id } = req.params;

    const { data: order, error } = await supabaseAdmin
      .from('orders')
      .select(`
        *,
        transactions(transaction_id, payment_type, transaction_status, midtrans_response),
        order_items(id, product_id, product_name, product_price, quantity, subtotal),
        shipment:order_shipments(id, order_id, courier, service_type, tracking_number, estimated_delivery, proof_of_delivery_url, shipped_at, delivered_at, biteship_order_id, biteship_label_url, tracking_history),
        refund:order_refunds(*)
      `)
      .eq('id', id)
      .single();

    if (error || !order) {
      return res.status(404).json({ error: 'Order not found' });
    }

    // Fetch user profile
    if (order.user_id) {
      const { data: profile } = await supabaseAdmin
        .from('profiles')
        .select('id, email, name')
        .eq('id', order.user_id)
        .single();
      
      if (profile) {
        order.user = {
          ...profile,
          name: profile.name || order.shipping_recipient_name || null
        };
      } else {
        order.user = {
          id: order.user_id,
          email: "Unknown",
          name: order.shipping_recipient_name || null
        };
      }
    }

    if (order.shipment) {
      const isArray = Array.isArray(order.shipment);
      const rawShipment = isArray ? order.shipment[0] : order.shipment;
      if (rawShipment) {
        const synced = await syncShipmentWithBiteship(rawShipment);
        if (isArray) {
          order.shipment[0] = synced;
        } else {
          order.shipment = synced;
        }

        const isDelivered = synced.delivered_at || 
          (Array.isArray(synced.tracking_history) && 
           synced.tracking_history.some((h: any) => (h.status || '').toLowerCase() === 'delivered'));

        if (isDelivered && !['delivered', 'completed', 'refund_process', 'refunded'].includes(order.status)) {
          order.status = 'delivered';
        }
      }
    }

    res.json({ success: true, data: order });
  } catch (error: any) {
    console.error('Get order detail error:', error);
    res.status(500).json({ error: 'Failed to fetch order detail' });
  }
};

/**
 * Create shipment & set status to shipped
 * POST /api/admin/orders/:id/shipment
 */
export const createShipment = async (req: Request, res: Response) => {
  try {
    const { id } = req.params;
    const { tracking_number, courier, service_type, estimated_delivery, proof_of_delivery_url } = req.body;

    if (!courier) {
      return res.status(400).json({ error: 'courier is required' });
    }

    // Check if order exists
    const { data: order, error: orderErr } = await supabaseAdmin
      .from('orders')
      .select('status, order_number, user_id, courier, shipping_address_id, shipping_recipient_name, shipping_phone, shipping_address, service_type')
      .eq('id', id)
      .single();

    if (orderErr || !order) {
      return res.status(404).json({ error: 'Order not found' });
    }

    let finalTrackingNumber = tracking_number;
    let biteshipOrderId = null;
    let biteshipLabelUrl = null;

    // If no tracking number is provided, we trigger Biteship automatic creation
    if (!finalTrackingNumber) {
      console.log(`[Biteship] Attempting automatic order creation for order ${id}...`);
      
      // Fetch recipient address details to get biteship_area_id
      const { data: addressDetails } = await supabaseAdmin
        .from('user_addresses')
        .select('*')
        .eq('id', order.shipping_address_id)
        .single();

      const destAreaId = addressDetails?.biteship_area_id || order.shipping_address_id; // Fallback
      const destPostalCode = addressDetails?.postal_code ? Number(addressDetails.postal_code) : undefined;

      // Fetch order items to get weights
      const { data: itemsDetails } = await supabaseAdmin
        .from('order_items')
        .select('*, products(weight_gram)')
        .eq('order_id', id);

      if (!itemsDetails || itemsDetails.length === 0) {
        return res.status(400).json({ error: 'Order has no items' });
      }

      const items = itemsDetails.map((item: any) => ({
        name: item.product_name,
        value: Math.round(item.product_price * item.quantity),
        weight: Math.round((item.products?.weight_gram || 500) * item.quantity), // grams total for item
        quantity: item.quantity
      }));

      // Define warehouse sender info from environment or default
      const shipperName = process.env.BITESHIP_ORIGIN_NAME || "Gudang Umah Tani";
      const shipperPhone = process.env.BITESHIP_ORIGIN_PHONE || "08123456789";
      const shipperAddress = process.env.BITESHIP_ORIGIN_ADDRESS || "Gudang Utama Umah Tani";
      const shipperAreaId = process.env.BITESHIP_ORIGIN_AREA_ID || "IDNP3IDNC396IDND4754IDZ42171";
      const shipperPostal = process.env.BITESHIP_ORIGIN_POSTAL_CODE ? Number(process.env.BITESHIP_ORIGIN_POSTAL_CODE) : 42171;

      const biteshipPayload: any = {
        shipper_contact_name: shipperName,
        shipper_contact_phone: shipperPhone,
        shipper_contact_email: "info@umahtani.com",
        origin_contact_name: shipperName,
        origin_contact_phone: shipperPhone,
        origin_address: shipperAddress,
        origin_area_id: shipperAreaId,
        origin_postal_code: shipperPostal,
        
        destination_contact_name: order.shipping_recipient_name || "Penerima",
        destination_contact_phone: order.shipping_phone || "08123456789",
        destination_address: order.shipping_address || "-",
        destination_area_id: destAreaId,
        destination_postal_code: destPostalCode,
        
        courier_company: courier.toLowerCase(),
        courier_type: (service_type || order.service_type || "reg").toLowerCase(),
        
        delivery_type: "now",
        items
      };

      const biteshipResult = await biteshipService.createOrder(biteshipPayload);
      
      if (!biteshipResult || !biteshipResult.id) {
        throw new Error("Gagal membuat order di Biteship");
      }

      biteshipOrderId = biteshipResult.id;
      finalTrackingNumber = biteshipResult.courier?.waybill_number || null;
      biteshipLabelUrl = biteshipResult.delivery?.label_url || null;

      console.log(`[Biteship] Order created: ${biteshipOrderId}, Resi: ${finalTrackingNumber}`);
    }

    // Check if shipment already exists
    const { data: existingShipment } = await supabaseAdmin
      .from('order_shipments')
      .select('id')
      .eq('order_id', id)
      .single();

    let shipmentData;
    
    if (existingShipment) {
      // Update shipment record
      const { data, error: shipmentError } = await supabaseAdmin
        .from('order_shipments')
        .update({
          courier,
          service_type,
          tracking_number: finalTrackingNumber,
          estimated_delivery,
          proof_of_delivery_url,
          biteship_order_id: biteshipOrderId,
          biteship_label_url: biteshipLabelUrl,
          shipped_at: new Date().toISOString(),
          updated_at: new Date().toISOString()
        })
        .eq('order_id', id)
        .select()
        .single();
        
      if (shipmentError) throw shipmentError;
      shipmentData = data;
    } else {
      // Create shipment record
      const { data, error: shipmentError } = await supabaseAdmin
        .from('order_shipments')
        .insert({
          order_id: id,
          courier,
          service_type,
          tracking_number: finalTrackingNumber,
          estimated_delivery,
          proof_of_delivery_url,
          biteship_order_id: biteshipOrderId,
          biteship_label_url: biteshipLabelUrl,
          shipped_at: new Date().toISOString()
        })
        .select()
        .single();
        
      if (shipmentError) throw shipmentError;
      shipmentData = data;
    }

    // Update order status
    const { error: orderError } = await supabaseAdmin
      .from('orders')
      .update({
        status: 'shipped',
        updated_at: new Date().toISOString()
      })
      .eq('id', id);

    if (orderError) throw orderError;

    // Send "Pesanan Sedang Dikirim" notification
    if (order && order.user_id) {
      const courierName = courier || order.courier || "kurir";
      await NotificationService.sendPersonalNotification(
        order.user_id,
        "Pesanan Sedang Dikirim 🚚",
        `Pesanan #${order.order_number} telah diserahkan ke kurir ${courierName}. Silakan lacak pengiriman Anda.`,
        "system"
      );
    }

    // Log admin activity
    await logActivity(
      req.userId || 'unknown_admin',
      'order_shipped',
      'order',
      String(id),
      {
        tracking_number: finalTrackingNumber,
        courier,
        service_type,
        biteship_order_id: biteshipOrderId,
        order_number: order?.order_number
      },
      req
    );

    res.json({
      success: true,
      message: 'Shipment created successfully',
      data: shipmentData
    });
  } catch (error: any) {
    console.error('Create shipment error:', error);
    res.status(500).json({ error: error.message || 'Failed to create shipment' });
  }
};


