<file path="generate-webhook-signature.js">
const crypto = require('crypto');
require('dotenv').config();

/**
 * Generate Midtrans Webhook Signature
 * Usage: node generate-webhook-signature.js <orderId> <grossAmount> [transactionId]
 */

// Get parameters from command line
const orderId = process.argv[2];
const grossAmount = process.argv[3];
const transactionId = process.argv[4] || 'test-transaction-123';
const statusCode = '200';
const serverKey = process.env.MIDTRANS_SERVER_KEY;

if (!orderId || !grossAmount) {
  console.error('Usage: node generate-webhook-signature.js <orderId> <grossAmount> [transactionId]');
  console.error('Example: node generate-webhook-signature.js ORD-1773217726770-123 1753000.00');
  process.exit(1);
}

if (!serverKey) {
  console.error('Error: MIDTRANS_SERVER_KEY not found in .env file');
  process.exit(1);
}

// Generate signature (SHA512)
const signatureString = `${orderId}${statusCode}${grossAmount}${serverKey}`;
const signature = crypto.createHash('sha512').update(signatureString).digest('hex');

console.log('\n=== Midtrans Webhook Signature Generated ===\n');
console.log('Order ID:', orderId);
console.log('Gross Amount:', grossAmount);
console.log('Transaction ID:', transactionId);
console.log('Signature:', signature);

console.log('\n=== Webhook Body for Postman (SETTLEMENT) ===\n');
const webhookBody = {
  transaction_time: new Date().toISOString().replace('T', ' ').substring(0, 19),
  transaction_status: 'settlement',
  transaction_id: transactionId,
  status_message: 'midtrans payment notification',
  status_code: statusCode,
  signature_key: signature,
  payment_type: 'qris',
  order_id: orderId,
  merchant_id: 'G123456789',
  gross_amount: grossAmount,
  fraud_status: 'accept',
  currency: 'IDR'
};

console.log(JSON.stringify(webhookBody, null, 2));

console.log('\n=== POST to: http://localhost:3000/api/payments/webhook/midtrans ===\n');

// Also generate for CANCEL status
const cancelWebhookBody = {
  ...webhookBody,
  transaction_status: 'cancel',
  status_message: 'payment cancelled'
};

console.log('\n=== Webhook Body for CANCEL ===\n');
console.log(JSON.stringify(cancelWebhookBody, null, 2));

console.log('\n');
